/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.aws.neon.tech; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
/assets/*
  Cache-Control: public, max-age=300, must-revalidate
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
